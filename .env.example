# Hosted Otari API root, ending in /api/v1 (confirm with your account).
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
OTARI_API_KEY=
# Two different open-weight model IDs, or role-specific Otari routing policy names.
# Instruct models return structured answers without spending the output cap on thinking.
OTARI_ANALYST_MODEL=alibaba/qwen3-235b-a22b-instruct-2507
OTARI_ENGINEER_MODEL=alibaba/qwen3-coder-30b-a3b-instruct
# Profile must exist on this deployment. Blocking checks fail closed.
OTARI_GUARDRAIL_PROFILE=
# A real Otari budget/spend ceiling must also be attached to this API key.
# This local threshold stops subsequent calls; it cannot cap a call already running.
BRIDGEFOX_JOB_BUDGET_USD=0.50
# Gate access if this server is exposed publicly. Use a long random password.
BRIDGEFOX_ACCESS_TOKEN=
