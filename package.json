{
  "name": "bridgefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3035",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3035",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:ui": "tsx scripts/check-ui.ts",
    "demo:zip": "tsx scripts/demo-zip.ts",
    "lint:addon": "web-ext lint --source-dir fixtures/tab-pocket --warnings-as-errors",
    "sync:compat": "node scripts/sync-compat.mjs",
    "check:firefox": "python3 scripts/check-firefox.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/space-grotesk": "^5.3.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "diff": "^8.0.2",
    "framer-motion": "^14.9.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.8",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "web-ext": "^10.8.0"
  }
}
